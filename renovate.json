{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>junkerderprovinz/junkerderprovinz//renovate/base",
    "local>junkerderprovinz/junkerderprovinz//renovate/components"
  ],
  "packageRules": [
    {
      "description": "Seafile and its notification server ship together and have to carry the same version",
      "matchPackageNames": [
        "seafileltd/seafile-mc",
        "seafileltd/notification-server"
      ],
      "groupName": "Seafile",
      "labels": [
        "base-image"
      ]
    }
  ]
}
